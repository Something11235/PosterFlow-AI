# Optional server-side default provider. Leave these empty when every user supplies a Key in the UI.
IMAGE_API_KEY=
IMAGE_API_ENDPOINT=https://openrouter.ai/api/v1/images
IMAGE_API_MODEL=openai/gpt-image-2
IMAGE_API_AUTH_TYPE=bearer

# Backward-compatible OpenRouter-only environment variable (optional).
# OPENROUTER_API_KEY=

PORT=5000
DATA_DIR=./backend
MAX_REQUEST_BYTES=25165824
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security switches. Keep disabled for public deployments.
ALLOW_PRIVATE_PROVIDER_HOSTS=0
ALLOW_INSECURE_PROVIDER_HTTP=0
