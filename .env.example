# Legacy single-user server-side provider. For public deployments use PLATFORM_IMAGE_*
# with Supabase credits instead. Never commit actual credentials.
IMAGE_API_KEY=
IMAGE_API_ENDPOINT=https://openrouter.ai/api/v1/images
IMAGE_API_MODEL=openai/gpt-image-2.5-flare
IMAGE_API_AUTH_TYPE=bearer

# Supabase Auth and database. Service-role values must remain server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# SUPABASE_SECRET_KEY= # accepted service-role alias for newer Supabase projects

# Browser-safe publishable configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY= # accepted anon-key alias
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Platform credit mode. Flask/Vercel Functions read these, never the browser.
PLATFORM_IMAGE_API_KEY=
PLATFORM_IMAGE_API_ENDPOINT=https://api2.jojocode.com/v1/images/generations
PLATFORM_IMAGE_MODEL=gpt-image-2.5-flare
PLATFORM_IMAGE_AUTH_TYPE=bearer
PLATFORM_DAILY_IMAGE_LIMIT=1000
USER_DAILY_IMAGE_LIMIT=20
ADMIN_USER_IDS=

HOST=127.0.0.1
PORT=5000
DATA_DIR=./backend
MAX_REQUEST_BYTES=25165824
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional online checkout. Keep all merchant secrets server-side.
# Set to alipay only after the Alipay face-to-face merchant channel is approved and configured.
PAYMENT_PROVIDER=disabled
PUBLIC_BASE_URL=https://www.example.com
# Legacy WeChat Native Pay variables are retained for historical deployments but ignored by active checkout.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_PUBLIC_KEY_ID=
WECHAT_API_V3_KEY=
WECHAT_API_BASE=https://api.mch.weixin.qq.com
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Security switches. Keep disabled for public deployments.
ALLOW_PRIVATE_PROVIDER_HOSTS=0
ALLOW_INSECURE_PROVIDER_HTTP=0
